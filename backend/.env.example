# ==============================================================================
# REAL PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=production
API_PREFIX=/api

# Database Connection (SQLite in local dev/testing; PostgreSQL in cloud production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL Production:
# DATABASE_URL="postgresql://school_admin:SUPER_STRONG_DB_PASS@db.school.internal:5432/school_prod?schema=public&sslmode=prefer"

# Security & JSON Web Tokens (MUST BE RANDOMLY GENERATED 64-BYTE SECRETS IN PRODUCTION)
JWT_ACCESS_SECRET="CHANGE_ME_IN_PRODUCTION_SUPER_SECURE_JWT_ACCESS_KEY_32_BYTES_MIN"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_SUPER_SECURE_JWT_REFRESH_KEY_32_BYTES_MIN"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Configuration (Allowed Institutional Web Origins)
CORS_ORIGIN="https://portal.school.edu"

# Rate Limiting & Account Security
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Super Administrator Seed Account (Only for First-Time Setup)
INITIAL_ADMIN_EMAIL="principal@school.edu"
INITIAL_ADMIN_USERNAME="principal"
INITIAL_ADMIN_PASSWORD="Admin@SecurePassword2026!"
INITIAL_ADMIN_FIRSTNAME="Arthur"
INITIAL_ADMIN_LASTNAME="Pendleton"

# Official Meta WhatsApp Cloud API Provider
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# SMTP / Email Notifications Provider
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="School Administration <no-reply@school.edu>"

# Institutional Timezone & Currency Configuration
INSTITUTION_TIMEZONE="Asia/Kolkata"
INSTITUTION_CURRENCY="INR"
