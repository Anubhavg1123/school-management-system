// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// CORE IDENTITIES & ACCESS CONTROL
// ----------------------------------------------------

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  username              String?   @unique
  passwordHash          String
  firstName             String
  lastName              String
  phone                 String?
  whatsAppNumber        String?
  altPhone              String?
  dob                   DateTime?
  gender                String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  idProofType           String?
  idProofNumber         String?
  userCategory          String?   // STUDENT, FACULTY, DRIVER, SECURITY_OFFICER, ATTENDER, MAINTENANCE_STAFF, OFFICE_STAFF, EXECUTIVE
  status                String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, UNDER_REVIEW, ACTIVE, INACTIVE, SUSPENDED
  activeRole            String    @default("STUDENT") // Primary/active role for JWT context
  failedLoginCount      Int       @default(0)
  failedLoginAttempts   Int       @default(0)
  lockoutUntil          DateTime?
  lockedUntil           DateTime?
  isMfaEnabled          Boolean   @default(false)
  mfaSecret             String?
  mfaBackupCodes        String?   // JSON array of hashed recovery codes
  lastLoginAt           DateTime?
  lastLoginIp           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  userRoles                     UserRole[]
  registrationRequest           RegistrationRequest?
  audits                        AuditLog[]
  attendances                   Attendance[]                  @relation("UserAttendance")
  markedAttendances             Attendance[]                  @relation("MarkedByAttendance")
  enteredByAttendances          Attendance[]                  @relation("EnteredByAttendance")
  leaves                        FacultyLeave[]                @relation("UserLeaves")
  reviewedLeaves                FacultyLeave[]                @relation("ReviewedLeaves")
  reviewedApprovals             ApprovalRecord[]              @relation("ReviewerApprovals")
  facultyProfile                Faculty?
  nonFacultyProfile             NonFacultyStaff?
  studentProfile                Student?
  requestedCorrections          AttendanceCorrection[]        @relation("RequestedCorrections")
  reviewedCorrections           AttendanceCorrection[]        @relation("ReviewedCorrections")
  refreshTokens                 RefreshToken[]
  notifications                 Notification[]
  managedDepartments            Department[]                 @relation("DepartmentHOD")
  assignedStudentFees           StudentFeeAssignment[]       @relation("AssignedFees")
  approvedDiscounts             FeeDiscount[]                @relation("ApprovedDiscounts")
  receivedPayments              Payment[]                    @relation("ReceivedPayments")
  issuedReceipts                Receipt[]                    @relation("IssuedReceipts")
  requestedRefunds              Refund[]                     @relation("RequestedRefunds")
  approvedRefunds               Refund[]                     @relation("ApprovedRefunds")
  assignedHods                  DepartmentHodHistory[]       @relation("AssignedByHod")
  hodHistories                  DepartmentHodHistory[]       @relation("UserHodHistory")
  assignedCoordinators          ClassCoordinatorHistory[]    @relation("AssignedByCoordinator")
  assignedFacultySubjects       FacultySubjectAssignment[]   @relation("AssignedByFacultySubject")
  createdTimetables             TimetableEntry[]             @relation("CreatedTimetableEntries")
  requestedExtraClasses         ExtraClassRequest[]          @relation("RequestedExtraClasses")
  reviewedExtraClasses          ExtraClassRequest[]          @relation("ReviewedExtraClasses")
  assignedSubstitutes           SubstituteFacultyAssignment[] @relation("AssignedBySubstitute")
  createdAttendanceSlots        AttendanceSlot[]              @relation("CreatedAttendanceSlots")
  markedStudentAttendances      StudentAttendance[]           @relation("MarkedByStudentAttendance")
  requestedStudentCorrections   StudentAttendanceCorrection[] @relation("RequestedStudentCorrections")
  reviewedStudentCorrections    StudentAttendanceCorrection[] @relation("ReviewedStudentCorrections")
  requestedBypasses             AcademicBypassRequest[]       @relation("RequestedBypasses")
  approvedBypasses              AcademicBypassRequest[]       @relation("ApprovedBypasses")
  attendanceAnomalies           AttendanceAnomaly[]
  createdAssignments            Assignment[]                  @relation("CreatedAssignments")
  vehicleRegistrations          FacultyVehicleRegistration[]  @relation("UserVehicleRegistrations")
  reviewedVehicleRegistrations  FacultyVehicleRegistration[]  @relation("ReviewedVehicleRegistrations")
  createdClassAnnouncements     ClassAnnouncement[]           @relation("CreatedClassAnnouncements")
  notificationEvents            NotificationEvent[]           @relation("RecipientNotificationEvents")
  createdDepartmentNotices      DepartmentNotice[]            @relation("CreatedDepartmentNotices")
  assignedVehiclesAssignedBy    VehicleAssignmentHistory[]   @relation("AssignedByVehicleAssignment")
  createdVehicleKmLogs          VehicleKmLog[]               @relation("CreatedVehicleKmLogs")
  enteredFuelRecords            FuelRecord[]                 @relation("EnteredFuelRecords")
  reportedVehicleMaintenances   VehicleMaintenance[]          @relation("ReportedVehicleMaintenances")
  updatedVehicleMaintenances   VehicleMaintenance[]          @relation("UpdatedVehicleMaintenances")
  personToMeetVisitorEntries    VisitorEntryExit[]            @relation("PersonToMeetVisitorEntries")
  entrySecurityVisitorEntries   VisitorEntryExit[]            @relation("EntrySecurityVisitorEntries")
  exitSecurityVisitorEntries    VisitorEntryExit[]            @relation("ExitSecurityVisitorEntries")
  entrySecurityCampusVehicles   CampusVehicleLog[]            @relation("EntrySecurityCampusVehicles")
  exitSecurityCampusVehicles    CampusVehicleLog[]            @relation("ExitSecurityCampusVehicles")
  createdNotices                Notice[]                      @relation("CreatedNotices")
  targetUserNotices             Notice[]                      @relation("TargetUserNotices")
  noticeAcknowledgments         NoticeAcknowledgment[]
  createdEventLogs              NotificationEventLog[]        @relation("CreatedEventLogs")
  notificationDeliveries        NotificationDelivery[]
  notificationPreferences       NotificationPreference[]
  createdTemplates              MessageTemplate[]
  createdApprovalRequests       GenericApprovalRequest[]      @relation("RequestedByApprovalRequests")
  approvalHistories             GenericApprovalHistory[]       @relation("ActionByApprovalHistories")
  promotedBatches               AcademicYearPromotion[]       @relation("PromotedByBatches")
  createdExaminations           Examination[]                 @relation("CreatedExaminations")
  markedExamAttendances        ExamAttendance[]              @relation("MarkedByExamAttendances")
  enteredMarks                  StudentMarks[]                @relation("EnteredByMarks")
  requestedMarksCorrections     MarksCorrectionRequest[]      @relation("RequestedByMarksCorrections")
  reviewedMarksCorrections      MarksCorrectionRequest[]      @relation("ReviewedByMarksCorrections")
  approvedResultSnapshots       StudentResultSnapshot[]       @relation("ApprovedResultSnapshots")
  guardianRelationships         GuardianStudentRelationship[] @relation("GuardianUserRelationships")
  guardianCommunicationPreference GuardianCommunicationPreference?
  requestedStudentProfileUpdates StudentProfileUpdateRequest[] @relation("RequestedStudentProfileUpdates")
  reviewedStudentProfileUpdates  StudentProfileUpdateRequest[] @relation("ReviewedStudentProfileUpdates")
  requestedStudentLeaves        StudentLeaveRequest[]         @relation("RequestedStudentLeaves")
  reviewedStudentLeaves         StudentLeaveRequest[]         @relation("ReviewedStudentLeaves")
  // Phase 15 relations
  createdSupportTickets         SupportTicket[]               @relation("CreatedTickets")
  assignedSupportTickets        SupportTicket[]               @relation("AssignedTickets")
  ticketComments                SupportTicketComment[]        @relation("TicketComments")
  dataImportLogs                DataImportLog[]               @relation("ImportLogs")
  // Phase 16 relations
  createdEmergencyAlerts        EmergencyAlert[]              @relation("CreatedEmergencyAlerts")
  approvedEmergencyAlerts       EmergencyAlert[]              @relation("ApprovedEmergencyAlerts")
  campusStatusLogs              CampusStatusLog[]             @relation("CampusStatusUpdater")
  createdStudentCases           StudentCase[]                 @relation("CreatedStudentCases")
  assignedStudentCases          StudentCase[]                 @relation("AssignedStudentCases")
  studentCaseActions            StudentCaseAction[]           @relation("StudentCaseActionPerformer")
  hostedPreRegisteredVisitors   VisitorPreRegistration[]      @relation("HostVisitorPreRegistrations")
  configAuditLogs               ConfigAuditLog[]              @relation("ConfigAuditUpdater")
  pushSubscriptions             PushSubscription[]            @relation("UserPushSubscriptions")
  // Phase 17 relations
  originalDelegations           ApprovalDelegation[]          @relation("OriginalApproverDelegations")
  receivedDelegations           ApprovalDelegation[]          @relation("DelegateUserDelegations")
  userEventRegistrations        EventRegistration[]           @relation("UserEventRegistrations")
  guardianPtmBookings           ParentTeacherMeetingBooking[] @relation("GuardianPtmBookings")
  verifiedStudentExits          StudentExitChecklist[]        @relation("ApprovedStudentExits")
  staffOnboardingChecklists     StaffOnboardingChecklist[]    @relation("StaffOnboardingUser")
  verifiedStaffOnboardings      StaffOnboardingChecklist[]    @relation("VerifiedStaffOnboardings")
  staffExitHandovers            StaffExitHandover[]           @relation("StaffExitUser")
  receivedStaffHandovers        StaffExitHandover[]           @relation("HandoverToUser")
  verifiedStaffHandovers        StaffExitHandover[]           @relation("VerifiedStaffHandovers")
  assignedInstitutionalAssets   InstitutionalAsset[]          @relation("AssignedUserAssets")
  assetAssignmentsAssignedBy    AssetAssignmentHistory[]      @relation("AssignedByAssetAssignments")
  submittedGrievances           InstitutionalGrievance[]      @relation("SubmittedGrievances")
  assignedGrievances            InstitutionalGrievance[]      @relation("AssignedGrievances")
  submittedFeedbacks            InstitutionalFeedback[]       @relation("SubmittedFeedbacks")
  createdPolicies               InstitutionalPolicy[]         @relation("CreatedPolicies")
  policyAcknowledgements        PolicyAcknowledgement[]       @relation("UserPolicyAcknowledgements")
  verifiedComplianceItems       ComplianceChecklistItem[]     @relation("VerifiedComplianceItems")
  assignedRecommendations       OperationalRecommendation[]   @relation("AssignedRecommendations")
  reviewedRecommendations       OperationalRecommendation[]   @relation("ReviewedRecommendations")
  ownedIncidents                InstitutionalIncident[]       @relation("OwnedIncidents")
  requestedDataCorrections      DataCorrectionRequest[]       @relation("RequestedDataCorrections")
  approvedDataCorrections       DataCorrectionRequest[]       @relation("ApprovedDataCorrections")

  @@index([email])
  @@index([username])
  @@index([status])
  @@index([userCategory])
}

model Role {
  id           String           @id @default(cuid())
  name         String           @unique // SUPER_ADMIN, OFFICE_ADMIN, HOD, FACULTY, NON_FACULTY, PARENT
  displayName  String
  description  String?
  isSystemRole Boolean          @default(true)
  createdAt    DateTime         @default(now())

  // Relations
  userRoles            UserRole[]
  rolePermissions      RolePermission[]
  registrationRequests RegistrationRequest[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique // e.g. users.view, users.create, students.create, fees.payment, timetable.manage
  module      String           // USERS, ACADEMIC, ATTENDANCE, AUDIT, SETTINGS, LEAVE, FEES, REPORTS, TIMETABLE
  description String?
  createdAt   DateTime         @default(now())

  // Relations
  rolePermissions RolePermission[]

  @@index([module])
  @@index([code])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id           String      @id @default(cuid())
  userId       String
  roleId       String
  departmentId String?     // For HOD / scoped roles
  isPrimary    Boolean     @default(true)
  assignedAt   DateTime    @default(now())
  assignedBy   String?

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RegistrationRequest {
  id                    String                 @id @default(cuid())
  userId                String                 @unique
  requestedRoleId       String
  departmentId          String?
  status                String                 @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  dob                   DateTime?
  gender                String?
  whatsAppNumber        String?
  altPhone              String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  userCategory          String?
  employeeIdSuggested   String?
  applicationNotes      String?
  idProofUrl            String?
  reviewerNotes         String?
  reviewedByUserId      String?
  reviewedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedRole         Role                   @relation(fields: [requestedRoleId], references: [id])
  department            Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  approvalRecords       ApprovalRecord[]

  @@index([status])
  @@index([createdAt])
}

model ApprovalRecord {
  id             String              @id @default(cuid())
  registrationId String
  reviewerId     String
  action         String              // APPROVED, REJECTED, UNDER_REVIEW
  reason         String?
  reviewedAt     DateTime            @default(now())

  registration   RegistrationRequest @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  reviewer       User                @relation("ReviewerApprovals", fields: [reviewerId], references: [id])

  @@index([registrationId])
}

model FacultyLeave {
  id               String    @id @default(cuid())
  userId           String
  facultyId        String?
  leaveType        String    // CASUAL, MEDICAL, DUTY, EARNED, MATERNITY_PATERNITY, OTHER
  startDate        DateTime
  endDate          DateTime
  totalDays        Int       @default(1)
  reason           String
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedByUserId String?
  reviewedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation("UserLeaves", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy       User?     @relation("ReviewedLeaves", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. CS, EC, ME
  name        String
  description String?
  hodUserId   String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hod                  User?                  @relation("DepartmentHOD", fields: [hodUserId], references: [id], onDelete: SetNull)
  userRoles            UserRole[]
  facultyMembers       Faculty[]
  classes              Class[]
  students             Student[]
  registrationRequests RegistrationRequest[]
  feeStructures        FeeStructure[]
  hodHistory           DepartmentHodHistory[]
  subjects             Subject[]
  notices              Notice[]
  timetableEntries     TimetableEntry[]
  departmentNotices    DepartmentNotice[]
  approvalRequests     GenericApprovalRequest[]

  @@index([code])
  @@index([status])
}

model DepartmentHodHistory {
  id               String     @id @default(cuid())
  departmentId     String
  hodUserId        String
  assignedByUserId String?
  startDate        DateTime   @default(now())
  endDate          DateTime?
  status           String     @default("ACTIVE") // ACTIVE, PAST
  reason           String?
  createdAt        DateTime   @default(now())

  department       Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  hod              User       @relation("UserHodHistory", fields: [hodUserId], references: [id], onDelete: Cascade)
  assignedBy       User?      @relation("AssignedByHod", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([hodUserId])
  @@index([status])
}

model AcademicYear {
  id                  String   @id @default(cuid())
  name                String   @unique // e.g. 2026-2027
  startDate           DateTime
  endDate             DateTime
  isCurrent           Boolean  @default(false)
  status              String   @default("UPCOMING") // UPCOMING, ACTIVE, ARCHIVED
  enrollmentPrefix    String?  // e.g. "26" (mandatory before activation)
  enrollmentSeqLength Int      @default(4)
  nextEnrollmentSeq   Int      @default(1)
  createdAt           DateTime @default(now())

  classes                   Class[]
  students                  Student[]
  feeStructures             FeeStructure[]
  studentFeeAssignments     StudentFeeAssignment[]
  payments                  Payment[]
  classSubjects             ClassSubject[]
  facultySubjectAssignments FacultySubjectAssignment[]
  timeSlots                 TimeSlot[]
  facultyAvailabilities     FacultyAvailability[]
  timetableEntries          TimetableEntry[]
  extraClassRequests        ExtraClassRequest[]
  coordinatorHistories      ClassCoordinatorHistory[]
  attendanceSlots           AttendanceSlot[]
  assignments               Assignment[]
  classAnnouncements        ClassAnnouncement[]
  institutionSettings       InstitutionSettings[]
  promotionsFrom            AcademicYearPromotion[]       @relation("PromotionsFrom")
  promotionsTo              AcademicYearPromotion[]       @relation("PromotionsTo")
  examinations              Examination[]
}

model Class {
  id             String       @id @default(cuid())
  departmentId   String?
  academicYearId String
  name           String       // e.g. Class 1, Class 8, Grade 10
  code           String       @unique // e.g. CSE-Y3
  order          Int          @default(1) // 1..12
  educationLevel String       @default("PRIMARY") // PRIMARY, MIDDLE, SECONDARY, HIGHER_SECONDARY
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  department                Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  academicYear              AcademicYear               @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  sections                  Section[]
  feeStructures             FeeStructure[]
  classSubjects             ClassSubject[]
  facultySubjectAssignments FacultySubjectAssignment[]
  timetableEntries          TimetableEntry[]
  extraClassRequests        ExtraClassRequest[]
  substituteAssignments     SubstituteFacultyAssignment[]
  attendanceSlots           AttendanceSlot[]
  assignments               Assignment[]
  classAnnouncements        ClassAnnouncement[]
  notices                   Notice[]
  promotionsFromClass       AcademicYearPromotion[]       @relation("PromotionsFromClass")
  promotionsToClass         AcademicYearPromotion[]       @relation("PromotionsToClass")
  examinationClasses        ExaminationClass[]
  examinationSubjects       ExaminationSubject[]

  @@unique([academicYearId, name])
  @@index([departmentId])
  @@index([academicYearId])
}

model Section {
  id                  String   @id @default(cuid())
  classId             String
  name                String   // e.g. Section A
  capacity            Int      @default(60)
  coordinatorFacultyId String?
  whatsAppGroupId              String?
  whatsAppGroupStatus          String?   @default("UNCONFIGURED")
  whatsAppGroupManagedByUserId String?
  whatsAppGroupLastSyncAt      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  class                     Class                      @relation(fields: [classId], references: [id], onDelete: Cascade)
  students                  Student[]
  coordinatorHistories      ClassCoordinatorHistory[]
  facultySubjectAssignments FacultySubjectAssignment[]
  timetableEntries          TimetableEntry[]
  extraClassRequests        ExtraClassRequest[]
  substituteAssignments     SubstituteFacultyAssignment[]
  attendanceSlots           AttendanceSlot[]
  assignments               Assignment[]
  classAnnouncements        ClassAnnouncement[]
  notices                   Notice[]
  examinationClasses        ExaminationClass[]

  @@unique([classId, name])
  @@index([classId])
}

model ClassCoordinatorHistory {
  id               String       @id @default(cuid())
  sectionId        String
  facultyId        String
  academicYearId   String
  assignedByUserId String?
  startDate        DateTime     @default(now())
  endDate          DateTime?
  status           String       @default("ACTIVE") // ACTIVE, PAST
  reason           String?
  createdAt        DateTime     @default(now())

  section          Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  faculty          Faculty      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  assignedBy       User?        @relation("AssignedByCoordinator", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([sectionId])
  @@index([facultyId])
  @@index([academicYearId])
}

model Subject {
  id           String   @id @default(cuid())
  code         String   @unique // e.g. CS101, MATH301
  name         String   // e.g. Data Structures & Algorithms
  type         String   @default("THEORY") // THEORY, PRACTICAL, LAB, ELECTIVE
  credits      Float    @default(3.0)
  departmentId String?
  description  String?
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department                Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  classSubjects             ClassSubject[]
  facultySubjectAssignments FacultySubjectAssignment[]
  timetableEntries          TimetableEntry[]
  extraClassRequests        ExtraClassRequest[]
  substituteAssignments     SubstituteFacultyAssignment[]
  attendanceSlots           AttendanceSlot[]
  assignments               Assignment[]
  examinationSubjects       ExaminationSubject[]
  studentMarks              StudentMarks[]
  resultSubjectDetails      StudentResultSubjectDetail[]

  @@index([code])
  @@index([departmentId])
  @@index([status])
}

model ClassSubject {
  id             String   @id @default(cuid())
  academicYearId String
  classId        String
  subjectId      String
  isCompulsory   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, classId, subjectId])
  @@index([academicYearId])
  @@index([classId])
  @@index([subjectId])
}

model FacultySubjectAssignment {
  id               String   @id @default(cuid())
  academicYearId   String
  facultyId        String
  classId          String
  sectionId        String?
  subjectId        String
  assignedByUserId String?
  status           String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academicYear     AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  faculty          Faculty      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  class            Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section          Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subject          Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  assignedBy       User?        @relation("AssignedByFacultySubject", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([academicYearId])
  @@index([facultyId])
  @@index([classId])
  @@index([sectionId])
  @@index([subjectId])
}

model Room {
  id          String   @id @default(cuid())
  roomNumber  String   @unique // e.g. R-101, LAB-3, SEM-HALL-A
  name        String   // e.g. Physics Main Lab, Lecture Hall 101
  building    String   // e.g. Block A, Science Wing
  floor       Int?     @default(1)
  capacity    Int      @default(60)
  type        String   @default("CLASSROOM") // CLASSROOM, LAB, COMPUTER_LAB, SEMINAR_HALL, AUDITORIUM, SPORTS_AREA, OTHER
  equipment   String?  // e.g. "Projector, Sound System, 40 PC Terminals"
  status      String   @default("ACTIVE") // ACTIVE, MAINTENANCE, INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  timetableEntries   TimetableEntry[]
  extraClassRequests ExtraClassRequest[]
  examinationSubjects ExaminationSubject[] @relation("RoomExamSubjects")

  @@index([roomNumber])
  @@index([type])
  @@index([status])
}

model TimeSlot {
  id             String   @id @default(cuid())
  academicYearId String
  dayOfWeek      String   // MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY, SUNDAY
  periodNumber   Int      // 1..10
  name           String   // e.g. Period 1, Morning Lab, Lunch Break
  startTime      String   // e.g. 09:00
  endTime        String   // e.g. 10:00
  isBreak        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear          AcademicYear                  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  timetableEntries      TimetableEntry[]
  facultyAvailabilities FacultyAvailability[]
  extraClassRequests    ExtraClassRequest[]
  substituteAssignments SubstituteFacultyAssignment[]
  attendanceSlots       AttendanceSlot[]

  @@unique([academicYearId, dayOfWeek, periodNumber])
  @@index([academicYearId])
  @@index([dayOfWeek])
}

model FacultyAvailability {
  id             String    @id @default(cuid())
  facultyId      String
  academicYearId String
  dayOfWeek      String    // MONDAY..SUNDAY
  timeSlotId     String?
  startTime      String?
  endTime        String?
  isAvailable    Boolean   @default(true)
  reason         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  faculty        Faculty      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  timeSlot       TimeSlot?    @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)

  @@index([facultyId])
  @@index([academicYearId])
  @@index([dayOfWeek])
}

model TimetableEntry {
  id              String   @id @default(cuid())
  academicYearId  String
  departmentId    String?
  classId         String
  sectionId       String
  subjectId       String?
  facultyId       String?
  roomId          String?
  timeSlotId      String
  dayOfWeek       String   // MONDAY..SUNDAY
  status          String   @default("ACTIVE") // ACTIVE, CANCELLED, MOVED
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  academicYear    AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  class           Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  section         Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject         Subject?         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  faculty         Faculty?         @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  room            Room?            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  timeSlot        TimeSlot         @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("CreatedTimetableEntries", fields: [createdByUserId], references: [id], onDelete: SetNull)
  attendanceSlots AttendanceSlot[]

  @@unique([timeSlotId, sectionId])
  @@index([academicYearId])
  @@index([classId])
  @@index([sectionId])
  @@index([facultyId])
  @@index([roomId])
  @@index([timeSlotId])
  @@index([dayOfWeek])
}

model ExtraClassRequest {
  id                String    @id @default(cuid())
  academicYearId    String
  classId           String
  sectionId         String
  subjectId         String
  facultyId         String
  roomId            String
  date              String    // YYYY-MM-DD
  timeSlotId        String?
  startTime         String
  endTime           String
  reason            String
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  requestedByUserId String
  reviewedByUserId  String?
  reviewNotes       String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  academicYear      AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class             Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  section           Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject           Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  faculty           Faculty          @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  room              Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  timeSlot          TimeSlot?        @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)
  requestedBy       User             @relation("RequestedExtraClasses", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reviewedBy        User?            @relation("ReviewedExtraClasses", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  attendanceSlots   AttendanceSlot[]

  @@index([academicYearId])
  @@index([classId])
  @@index([facultyId])
  @@index([date])
  @@index([status])
}

model SubstituteFacultyAssignment {
  id                  String   @id @default(cuid())
  timetableEntryId    String?
  originalFacultyId   String
  substituteFacultyId String
  date                String   // YYYY-MM-DD
  classId             String
  sectionId           String
  subjectId           String
  timeSlotId          String
  roomId              String?
  reason              String
  assignedByUserId    String
  status              String   @default("CONFIRMED") // CONFIRMED, COMPLETED, CANCELLED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  originalFaculty     Faculty  @relation("OriginalFacultySubstitutes", fields: [originalFacultyId], references: [id], onDelete: Cascade)
  substituteFaculty   Faculty  @relation("SubstituteFacultyAssignments", fields: [substituteFacultyId], references: [id], onDelete: Cascade)
  class               Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  section             Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject             Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  timeSlot            TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  assignedBy          User     @relation("AssignedBySubstitute", fields: [assignedByUserId], references: [id], onDelete: Cascade)

  @@index([originalFacultyId])
  @@index([substituteFacultyId])
  @@index([date])
  @@index([timeSlotId])
}

model Student {
  id               String                 @id @default(cuid())
  userId           String                 @unique
  campusId         String?                @unique // Permanent 5-digit sequential campus ID e.g. "00001"
  admissionNumber  String                 @unique // e.g. ADM-2026-0001
  enrollmentNumber String?                @unique // e.g. 260001
  rollNumber       String?
  academicYearId   String?
  departmentId     String?
  sectionId        String?
  admissionDate    DateTime               @default(now())
  dateOfBirth      DateTime?
  gender           String?
  bloodGroup       String?
  emergencyContact String?
  previousSchool   String?
  previousGrade    String?
  previousScore    String?
  photoUrl         String?
  status           String                 @default("ACTIVE") // ACTIVE, INACTIVE, TRANSFERRED, LEFT_INSTITUTION, GRADUATED, SUSPENDED
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear?          @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  department       Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  section          Section?               @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  guardians        Guardian[]
  transferHistory  StudentTransferLog[]
  documents        StudentDocument[]
  feeAssignments   StudentFeeAssignment[]
  discounts        FeeDiscount[]
  payments         Payment[]
  receipts         Receipt[]
  refunds          Refund[]
  studentAttendances StudentAttendance[]
  bypassRequests   AcademicBypassRequest[]
  assignmentTargets AssignmentTarget[]
  visitors         Visitor[]               @relation("StudentVisitors")
  targetStudentNotices Notice[]             @relation("TargetStudentNotices")
  examEligibilities    ExamEligibility[]
  examAttendances      ExamAttendance[]
  studentMarks         StudentMarks[]
  resultSnapshots      StudentResultSnapshot[]
  guardianRelationships GuardianStudentRelationship[]
  profileUpdateRequests StudentProfileUpdateRequest[]
  studentLeaveRequests StudentLeaveRequest[]
  studentCases         StudentCase[]
  // Phase 17 relations
  exitChecklist        StudentExitChecklist?
  alumniProfile        AlumniProfile?
  studentEventRegistrations EventRegistration[]           @relation("StudentEventRegistrations")
  studentPtmBookings   ParentTeacherMeetingBooking[]      @relation("StudentPtmBookings")

  @@index([campusId])
  @@index([admissionNumber])
  @@index([enrollmentNumber])
  @@index([status])
  @@index([departmentId])
  @@index([academicYearId])
}

model StudentTransferLog {
  id                  String   @id @default(cuid())
  studentId           String
  fromAcademicYearId  String?
  toAcademicYearId    String?
  fromDepartmentId    String?
  toDepartmentId      String?
  fromClassId         String?
  toClassId           String?
  fromSectionId       String?
  toSectionId         String?
  fromStatus          String?
  toStatus            String?
  transferType        String   // CLASS_TRANSFER, SECTION_TRANSFER, PROMOTION, STATUS_CHANGE, DEPT_TRANSFER
  reason              String
  effectiveDate       DateTime @default(now())
  transferredByUserId String?
  createdAt           DateTime @default(now())

  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([transferType])
  @@index([effectiveDate])
}

model StudentDocument {
  id                String   @id @default(cuid())
  studentId         String
  docType           String   // PHOTO, BIRTH_CERTIFICATE, PREVIOUS_MARKSHEET, ID_PROOF, TRANSFER_CERTIFICATE, MEDICAL_RECORD, OTHER
  title             String
  fileUrl           String
  fileSize          Int?
  mimeType          String?
  uploadedByUserId  String?
  createdAt         DateTime @default(now())

  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([docType])
}

model Guardian {
  id           String   @id @default(cuid())
  studentId    String
  fullName     String
  relationship String   // FATHER, MOTHER, LEGAL_GUARDIAN
  phone        String
  email        String?
  occupation   String?
  address      String?
  isPrimary    Boolean  @default(true)
  createdAt    DateTime @default(now())

  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// ----------------------------------------------------
// FINANCIAL AND FEE MANAGEMENT MODULE ENTITIES
// ----------------------------------------------------

model FeeCategory {
  id          String   @id @default(cuid())
  code        String   @unique // TUITION, ADMISSION, EXAM, LAB, TRANSPORT, LIBRARY, SPORTS, ACTIVITY, OTHER
  name        String
  description String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  structureItems  FeeStructureItem[]
  studentFeeItems StudentFeeItem[]

  @@index([code])
  @@index([status])
}

model FeeStructure {
  id             String   @id @default(cuid())
  code           String   @unique // e.g. FS-2026-CLASS10, FS-2026-CLASS1
  name           String   // e.g. Class 10 Standard Annual Fee Structure 2026-27
  academicYearId String
  classId        String?
  departmentId   String?
  description    String?
  status         String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear   AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class?                 @relation(fields: [classId], references: [id], onDelete: SetNull)
  department     Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  items          FeeStructureItem[]
  assignments    StudentFeeAssignment[]

  @@index([academicYearId])
  @@index([classId])
  @@index([departmentId])
  @@index([status])
}

model FeeStructureItem {
  id               String   @id @default(cuid())
  feeStructureId   String
  feeCategoryId    String
  amount           Float
  isOptional       Boolean  @default(false)
  dueDate          DateTime?
  installmentCount Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  feeStructure     FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeCategory      FeeCategory  @relation(fields: [feeCategoryId], references: [id], onDelete: Cascade)

  @@unique([feeStructureId, feeCategoryId])
  @@index([feeStructureId])
  @@index([feeCategoryId])
}

model StudentFeeAssignment {
  id                  String   @id @default(cuid())
  studentId           String
  feeStructureId      String
  academicYearId      String
  totalAssignedAmount Float
  totalDiscountAmount Float    @default(0)
  totalPaidAmount     Float    @default(0)
  totalRefundedAmount Float    @default(0)
  netPayableAmount    Float
  status              String   @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  assignedAt          DateTime @default(now())
  assignedByUserId    String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  student             Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure        FeeStructure   @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  academicYear        AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  assignedBy          User?          @relation("AssignedFees", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  items               StudentFeeItem[]
  installments        FeeInstallment[]
  discounts           FeeDiscount[]
  payments            Payment[]

  @@unique([studentId, feeStructureId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([status])
}

model StudentFeeItem {
  id             String   @id @default(cuid())
  feeAssignmentId String
  feeCategoryId  String
  originalAmount Float
  discountAmount Float    @default(0)
  netAmount      Float
  paidAmount     Float    @default(0)
  status         String   @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID, OVERDUE
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  feeAssignment  StudentFeeAssignment @relation(fields: [feeAssignmentId], references: [id], onDelete: Cascade)
  feeCategory    FeeCategory          @relation(fields: [feeCategoryId], references: [id], onDelete: Cascade)

  @@index([feeAssignmentId])
  @@index([feeCategoryId])
}

model FeeInstallment {
  id                String   @id @default(cuid())
  feeAssignmentId   String
  installmentNumber Int
  name              String   // e.g. Installment 1 (Term 1)
  amount            Float
  dueDate           DateTime
  paidAmount        Float    @default(0)
  status            String   @default("UPCOMING") // UPCOMING, DUE, PARTIALLY_PAID, PAID, OVERDUE
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  feeAssignment     StudentFeeAssignment @relation(fields: [feeAssignmentId], references: [id], onDelete: Cascade)

  @@index([feeAssignmentId])
  @@index([status])
  @@index([dueDate])
}

model FeeDiscount {
  id               String   @id @default(cuid())
  feeAssignmentId  String
  studentId        String
  type             String   // FIXED_AMOUNT, PERCENTAGE, SCHOLARSHIP, CONCESSION, WAIVER
  amount           Float
  percentage       Float?
  reason           String
  status           String   @default("ACTIVE") // ACTIVE, REVOKED
  approvedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  feeAssignment    StudentFeeAssignment @relation(fields: [feeAssignmentId], references: [id], onDelete: Cascade)
  student          Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  approvedBy       User?                @relation("ApprovedDiscounts", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([feeAssignmentId])
  @@index([studentId])
  @@index([status])
}

model Payment {
  id                   String   @id @default(cuid())
  paymentNumber        String   @unique // e.g. PAY-2026-0001
  studentId            String
  feeAssignmentId      String
  academicYearId       String
  amount               Float
  paymentDate          DateTime @default(now())
  paymentMethod        String   // CASH, UPI, BANK_TRANSFER, ONLINE, CHEQUE, OTHER
  transactionReference String?  @unique
  status               String   @default("SUCCESS") // SUCCESS, PENDING, FAILED, CANCELLED, REFUNDED, PARTIALLY_REFUNDED
  receivedByUserId     String?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  student              Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeAssignment        StudentFeeAssignment @relation(fields: [feeAssignmentId], references: [id], onDelete: Cascade)
  academicYear         AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  receivedBy           User?                @relation("ReceivedPayments", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  receipt              Receipt?
  refunds              Refund[]

  @@index([studentId])
  @@index([feeAssignmentId])
  @@index([paymentDate])
  @@index([status])
}

model Receipt {
  id                   String   @id @default(cuid())
  receiptNumber        String   @unique // e.g. RCP-2026-0001
  paymentId            String   @unique
  studentId            String
  amountPaid           Float
  totalAssigned        Float
  totalRemainingBalance Float
  issuedDate           DateTime @default(now())
  issuedByUserId       String?
  notes                String?
  createdAt            DateTime @default(now())

  payment              Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  student              Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  issuedBy             User?    @relation("IssuedReceipts", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  @@index([receiptNumber])
  @@index([studentId])
}

model Refund {
  id                String   @id @default(cuid())
  refundNumber      String   @unique // e.g. REF-2026-0001
  paymentId         String
  studentId         String
  amount            Float
  reason            String
  status            String   @default("PROCESSED") // PROCESSED, CANCELLED
  requestedByUserId String?
  approvedByUserId  String?
  refundDate        DateTime @default(now())
  createdAt         DateTime @default(now())

  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestedBy       User?    @relation("RequestedRefunds", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  approvedBy        User?    @relation("ApprovedRefunds", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([studentId])
  @@index([refundDate])
}

// ----------------------------------------------------
// OTHER INSTITUTIONAL MODULES
// ----------------------------------------------------

model Faculty {
  id            String      @id @default(cuid())
  userId        String      @unique
  employeeCode  String      @unique
  departmentId  String
  designation   String      // PROFESSOR, ASSOCIATE_PROFESSOR, ASST_PROFESSOR, LECTURER
  qualification String?
  joiningDate   DateTime    @default(now())
  isHod         Boolean     @default(false)
  status        String      @default("ACTIVE") // ACTIVE, ON_LEAVE, RESIGNED
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user                  User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  department            Department                    @relation(fields: [departmentId], references: [id])
  coordinatorHistories  ClassCoordinatorHistory[]
  subjectAssignments    FacultySubjectAssignment[]
  availabilities        FacultyAvailability[]
  timetableEntries      TimetableEntry[]
  extraClasses          ExtraClassRequest[]
  originalSubstitutes   SubstituteFacultyAssignment[] @relation("OriginalFacultySubstitutes")
  substituteAssignments SubstituteFacultyAssignment[] @relation("SubstituteFacultyAssignments")
  attendanceSlots       AttendanceSlot[]
  assignments           Assignment[]
  vehicleRegistrations  FacultyVehicleRegistration[]
  classAnnouncements    ClassAnnouncement[]
  invigilatorExamSubjects ExaminationSubject[] @relation("InvigilatorFacultySubjects")
  // Phase 17 relations
  ptmSlots              ParentTeacherMeetingSlot[]    @relation("FacultyPtmSlots")

  @@index([employeeCode])
  @@index([departmentId])
  @@index([status])
}

model NonFacultyStaff {
  id               String   @id @default(cuid())
  userId           String   @unique
  employeeCode     String   @unique
  jobTitle         String   // DRIVER, SECURITY_OFFICER, ATTENDER, MAINTENANCE_STAFF
  departmentOrUnit String?
  joiningDate      DateTime @default(now())
  status           String   @default("ACTIVE") // ACTIVE, ON_LEAVE, RESIGNED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedVehicles   Vehicle[]                  @relation("AssignedDriverVehicles")
  vehicleAssignments VehicleAssignmentHistory[] @relation("DriverVehicleAssignments")
  kmLogs             VehicleKmLog[]             @relation("DriverVehicleKmLogs")
  fuelRecords        FuelRecord[]               @relation("DriverFuelRecords")
  maintenances       VehicleMaintenance[]        @relation("DriverVehicleMaintenances")

  @@index([employeeCode])
  @@index([status])
}

model Attendance {
  id               String                 @id @default(cuid())
  userId           String
  date             String                 // YYYY-MM-DD
  checkInTime      DateTime?
  checkOutTime     DateTime?
  status           String                 @default("PRESENT") // PRESENT, ABSENT, LATE, HALF_DAY, EXCUSED, ON_LEAVE, MISSING_CHECKOUT, WORK_FROM_HOME
  lateMinutes      Int                    @default(0)
  deviceId         String?
  source           String                 @default("WEB") // WEB, KIOSK, MANUAL, ATTENDER
  kioskIdentifier  String?
  ipAddress        String?
  markedByUserId   String?
  enteredByUserId  String?                // For attender-assisted attendance
  remarks          String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user             User                   @relation("UserAttendance", fields: [userId], references: [id], onDelete: Cascade)
  markedBy         User?                  @relation("MarkedByAttendance", fields: [markedByUserId], references: [id], onDelete: SetNull)
  enteredBy        User?                  @relation("EnteredByAttendance", fields: [enteredByUserId], references: [id], onDelete: SetNull)
  corrections      AttendanceCorrection[]

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([status])
}

model AttendanceCorrection {
  id                 String     @id @default(cuid())
  attendanceId       String
  requestedByUserId  String
  proposedCheckIn    DateTime?
  proposedCheckOut   DateTime?
  proposedStatus     String?
  reason             String
  status             String     @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedByUserId   String?
  reviewedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime   @default(now())

  attendance         Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  requestedBy        User       @relation("RequestedCorrections", fields: [requestedByUserId], references: [id])
  reviewedBy         User?      @relation("ReviewedCorrections", fields: [reviewedByUserId], references: [id])

  @@index([attendanceId])
  @@index([status])
}

// ----------------------------------------------------
// PHASE 6: REAL-TIME STUDENT ATTENDANCE MODULE ENTITIES
// ----------------------------------------------------

model AttendanceSlot {
  id                  String    @id @default(cuid())
  academicYearId      String
  date                String    // YYYY-MM-DD
  classId             String
  sectionId           String
  subjectId           String
  facultyId           String
  timeSlotId          String?
  startTime           String
  endTime             String
  timetableEntryId    String?
  extraClassRequestId String?
  status              String    @default("SCHEDULED") // SCHEDULED, OPEN, IN_PROGRESS, SUBMITTED, FINALIZED, CANCELLED
  source              String    @default("AUTOMATIC") // AUTOMATIC, MANUAL, EXTRA_CLASS
  submissionDeadline  DateTime?
  createdByUserId     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  academicYear        AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class               Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  section             Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject             Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  faculty             Faculty            @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  timeSlot            TimeSlot?          @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)
  timetableEntry      TimetableEntry?    @relation(fields: [timetableEntryId], references: [id], onDelete: SetNull)
  extraClassRequest   ExtraClassRequest? @relation(fields: [extraClassRequestId], references: [id], onDelete: SetNull)
  createdBy           User?              @relation("CreatedAttendanceSlots", fields: [createdByUserId], references: [id], onDelete: SetNull)

  studentAttendances  StudentAttendance[]
  bypassRequests      AcademicBypassRequest[]

  @@unique([academicYearId, classId, sectionId, subjectId, date, timeSlotId])
  @@index([academicYearId])
  @@index([classId])
  @@index([sectionId])
  @@index([facultyId])
  @@index([date])
  @@index([status])
}

model StudentAttendance {
  id               String   @id @default(cuid())
  attendanceSlotId String
  studentId        String
  status           String   @default("PRESENT") // PRESENT, ABSENT, LATE, EXCUSED, ACADEMIC_BYPASS
  remarks          String?
  markedByUserId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attendanceSlot   AttendanceSlot @relation(fields: [attendanceSlotId], references: [id], onDelete: Cascade)
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy         User?          @relation("MarkedByStudentAttendance", fields: [markedByUserId], references: [id], onDelete: SetNull)

  corrections      StudentAttendanceCorrection[]

  @@unique([attendanceSlotId, studentId])
  @@index([attendanceSlotId])
  @@index([studentId])
  @@index([status])
}

model StudentAttendanceCorrection {
  id                  String   @id @default(cuid())
  studentAttendanceId String
  requestedByUserId   String
  originalStatus      String
  proposedStatus      String
  reason              String
  status              String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedByUserId    String?
  reviewedAt          DateTime?
  reviewNotes         String?
  createdAt           DateTime @default(now())

  studentAttendance   StudentAttendance @relation(fields: [studentAttendanceId], references: [id], onDelete: Cascade)
  requestedBy         User              @relation("RequestedStudentCorrections", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reviewedBy          User?             @relation("ReviewedStudentCorrections", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([studentAttendanceId])
  @@index([status])
}

model AcademicBypassRequest {
  id                String    @id @default(cuid())
  studentId         String
  attendanceSlotId  String?
  date              String    // YYYY-MM-DD
  activityName      String    // Sports, Competition, Official Event
  reason            String
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedByUserId String
  approvedByUserId  String?
  createdAt         DateTime  @default(now())

  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendanceSlot    AttendanceSlot? @relation(fields: [attendanceSlotId], references: [id], onDelete: SetNull)
  requestedBy       User            @relation("RequestedBypasses", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  approvedBy        User?           @relation("ApprovedBypasses", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([status])
  @@index([date])
}

model AttendanceAnomaly {
  id          String   @id @default(cuid())
  type        String   // DELAYED_SUBMISSION, OUTSIDE_WINDOW, REPEATED_MODIFICATION, MISSING_FACULTY_CHECKOUT, MISSING_ATTENDANCE_SESSION, DUPLICATE_SUBMISSION_ATTEMPT
  description String
  entityType  String   // AttendanceSlot, Attendance, StudentAttendance
  entityId    String?
  userId      String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String   // USER_LOGIN, REGISTRATION_APPROVED, ATTENDANCE_CHECKIN, FEE_PAYMENT_COLLECTED, TIMETABLE_CREATED, etc.
  entityType   String   // User, RegistrationRequest, Attendance, SystemSettings, FacultyLeave, Student, Payment, FeeStructure, Refund, Department, Subject, TimetableEntry, ExtraClass, SubstituteFaculty, AttendanceSlot, StudentAttendance, AcademicBypassRequest
  entityId     String?
  beforeState  String?  // JSON string
  afterState   String?  // JSON string
  ipAddress    String?
  userAgent    String?
  status       String   @default("SUCCESS") // SUCCESS, FAILURE
  errorMessage String?
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  deviceInfo String?
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model SystemSetting {
  id          String   @id @default(cuid())
  category    String   // GENERAL, SECURITY, ACADEMIC, ATTENDANCE, FINANCIAL, TIMETABLE
  key         String   @unique
  value       String
  isPublic    Boolean  @default(false)
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([key])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("SYSTEM") // SYSTEM, APPROVAL, ALERT, TIMETABLE
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

// ----------------------------------------------------
// PHASE 7: FACULTY PORTAL ENTITIES
// ----------------------------------------------------

model Assignment {
  id              String   @id @default(cuid())
  academicYearId  String
  classId         String
  sectionId       String
  subjectId       String
  facultyId       String
  createdByUserId String
  title           String
  description     String
  issueDate       DateTime @default(now())
  dueDate         DateTime
  status          String   @default("DRAFT") // DRAFT, PUBLISHED, CLOSED, ARCHIVED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  academicYear    AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class           Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  section         Section                @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject         Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  faculty         Faculty                @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  createdBy       User                   @relation("CreatedAssignments", fields: [createdByUserId], references: [id], onDelete: Cascade)
  attachments     AssignmentAttachment[]
  targets         AssignmentTarget[]

  @@index([academicYearId])
  @@index([classId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([facultyId])
  @@index([status])
}

model AssignmentAttachment {
  id           String   @id @default(cuid())
  assignmentId String
  title        String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  createdAt    DateTime @default(now())

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}

model AssignmentTarget {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  status       String   @default("PENDING") // PENDING, SUBMITTED, GRADED
  grade        String?
  feedback     String?
  submittedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
}

model FacultyVehicleRegistration {
  id                  String    @id @default(cuid())
  userId              String
  facultyId           String?
  vehicleNumber       String    @unique
  vehicleType         String    // TWO_WHEELER, FOUR_WHEELER, BICYCLE, OTHER
  makeModel           String?
  color               String?
  registrationDetails String?
  documentUrl         String?
  status              String    @default("PENDING") // PENDING, APPROVED, REJECTED, INACTIVE
  approvedByUserId    String?
  approvedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation("UserVehicleRegistrations", fields: [userId], references: [id], onDelete: Cascade)
  faculty             Faculty?  @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  approvedBy          User?     @relation("ReviewedVehicleRegistrations", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([vehicleNumber])
  @@index([status])
}

model ClassAnnouncement {
  id                     String   @id @default(cuid())
  academicYearId         String
  classId                String
  sectionId              String
  facultyId              String
  createdByUserId        String
  title                  String
  content                String
  category               String   @default("ACADEMIC") // ACADEMIC, ASSIGNMENT_REMINDER, EXAM_REMINDER, ROOM_CHANGE, GENERAL
  isClassCoordinatorOnly Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  academicYear           AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class                  Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section                Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  faculty                Faculty      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  createdBy              User         @relation("CreatedClassAnnouncements", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([academicYearId])
  @@index([classId])
  @@index([sectionId])
  @@index([facultyId])
  @@index([category])
}

model NotificationEvent {
  id              String   @id @default(cuid())
  eventType       String   // ASSIGNMENT_PUBLISHED, LEAVE_STATUS_CHANGED, EXTRA_CLASS_STATUS_CHANGED, VEHICLE_STATUS_CHANGED, CLASS_ANNOUNCEMENT
  payload         String   // JSON string
  targetType      String   // STUDENT, PARENT, FACULTY, HOD, ALL
  recipientUserId String?
  parentContact   String?
  status          String   @default("PENDING") // PENDING, DISPATCHED, FAILED
  createdAt       DateTime @default(now())

  recipientUser   User?    @relation("RecipientNotificationEvents", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

model DepartmentNotice {
  id              String   @id @default(cuid())
  departmentId    String
  createdByUserId String
  title           String
  content         String
  targetScope     String   @default("DEPARTMENT") // DEPARTMENT, FACULTY_ONLY, STUDENT_ONLY, SPECIFIC_CLASS
  classId         String?
  sectionId       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  department      Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy       User       @relation("CreatedDepartmentNotices", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@index([targetScope])
}

// ----------------------------------------------------
// PHASE 9: NON-FACULTY, VEHICLE & VISITOR MODULE ENTITIES
// ----------------------------------------------------

model StaffCategory {
  id          String   @id @default(cuid())
  code        String   @unique // DRIVER, SECURITY, ATTENDER, MAINTENANCE, HOUSEKEEPING, OFFICE_SUPPORT, OTHER
  name        String
  description String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@index([status])
}

model Vehicle {
  id                 String    @id @default(cuid())
  registrationNumber String    @unique // Unique registration number e.g. KA-01-AB-1234
  vehicleType        String    // BUS, VAN, CAR, TWO_WHEELER, TRUCK, AMBULANCE, OTHER
  makeModel          String?
  color              String?
  fuelType           String    @default("DIESEL") // DIESEL, PETROL, ELECTRIC, CNG, HYBRID
  capacity           Int       @default(40)
  ownerType          String    @default("INSTITUTION") // INSTITUTION, FACULTY, STAFF, VENDOR
  assignedDriverId   String?
  insuranceNumber    String?
  insuranceExpiry    DateTime?
  registrationExpiry DateTime?
  fitnessExpiry      DateTime?
  permitExpiry       DateTime?
  status             String    @default("ACTIVE") // ACTIVE, INACTIVE, UNDER_MAINTENANCE, RETIRED
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignedDriver      NonFacultyStaff?           @relation("AssignedDriverVehicles", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  assignments         VehicleAssignmentHistory[]
  kmLogs              VehicleKmLog[]
  fuelRecords         FuelRecord[]
  maintenances        VehicleMaintenance[]
  campusVehicleLogs   CampusVehicleLog[]

  @@index([registrationNumber])
  @@index([vehicleType])
  @@index([status])
  @@index([assignedDriverId])
}

model VehicleAssignmentHistory {
  id               String    @id @default(cuid())
  vehicleId        String
  driverId         String
  assignedByUserId String?
  startDate        DateTime  @default(now())
  endDate          DateTime?
  status           String    @default("ACTIVE") // ACTIVE, PAST
  notes            String?
  createdAt        DateTime  @default(now())

  vehicle          Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver           NonFacultyStaff @relation("DriverVehicleAssignments", fields: [driverId], references: [id], onDelete: Cascade)
  assignedBy       User?           @relation("AssignedByVehicleAssignment", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([driverId])
  @@index([status])
}

model VehicleKmLog {
  id              String   @id @default(cuid())
  vehicleId       String
  driverId        String
  date            String   // YYYY-MM-DD
  startingKm      Float
  endingKm        Float
  totalKm         Float
  purpose         String?
  route           String?
  remarks         String?
  createdByUserId String
  createdAt       DateTime @default(now())

  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver          NonFacultyStaff @relation("DriverVehicleKmLogs", fields: [driverId], references: [id], onDelete: Cascade)
  createdBy       User            @relation("CreatedVehicleKmLogs", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([driverId])
  @@index([date])
}

model FuelRecord {
  id              String   @id @default(cuid())
  vehicleId       String
  driverId        String
  date            String   // YYYY-MM-DD
  fuelType        String   // DIESEL, PETROL, CNG, ELECTRIC_KWH
  quantity        Float
  pricePerUnit    Float
  totalCost       Float
  odometerReading Float
  fuelStation     String?
  receiptNumber   String?
  remarks         String?
  enteredByUserId String
  createdAt       DateTime @default(now())

  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver          NonFacultyStaff @relation("DriverFuelRecords", fields: [driverId], references: [id], onDelete: Cascade)
  enteredBy       User            @relation("EnteredFuelRecords", fields: [enteredByUserId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([driverId])
  @@index([date])
}

model VehicleMaintenance {
  id                String    @id @default(cuid())
  vehicleId         String
  driverId          String?
  date              String    // YYYY-MM-DD
  problem           String
  workPerformed     String?
  garageVendor      String?
  estimatedCost     Float?    @default(0.0)
  actualCost        Float?    @default(0.0)
  odometerReading   Float?
  partsReplaced     String?
  remarks           String?
  status            String    @default("REPORTED") // REPORTED, UNDER_INSPECTION, IN_PROGRESS, COMPLETED, CANCELLED
  reportedByUserId  String
  updatedByUserId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  vehicle           Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver            NonFacultyStaff? @relation("DriverVehicleMaintenances", fields: [driverId], references: [id], onDelete: SetNull)
  reportedBy        User             @relation("ReportedVehicleMaintenances", fields: [reportedByUserId], references: [id], onDelete: Cascade)
  updatedBy         User?            @relation("UpdatedVehicleMaintenances", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([status])
  @@index([date])
}

model Visitor {
  id                  String   @id @default(cuid())
  fullName            String
  contactNumber       String
  visitorType         String   @default("GUEST") // PARENT, GUARDIAN, FAMILY, VENDOR, DELIVERY, GUEST, CONTRACTOR, OFFICIAL, OTHER
  studentRelationship String?  // FATHER, MOTHER, GUARDIAN, SIBLING, OTHER
  studentId           String?
  address             String?
  idProofType         String?  // AADHAAR, DRIVING_LICENSE, PASSPORT, VOTER_ID, OTHER
  idProofNumber       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  student             Student?           @relation("StudentVisitors", fields: [studentId], references: [id], onDelete: SetNull)
  entryExits          VisitorEntryExit[]

  @@index([fullName])
  @@index([contactNumber])
  @@index([visitorType])
  @@index([studentId])
}

model VisitorEntryExit {
  id                    String    @id @default(cuid())
  visitorId             String
  personToMeetName      String
  personToMeetUserId    String?
  purpose               String
  vehicleNumber         String?
  vehicleType           String?
  passNumber            String    @unique // Unique pass identifier e.g. PASS-20260825-001
  passToken             String    @unique // Secure server token for QR validation
  entryTime             DateTime  @default(now())
  exitTime              DateTime?
  entrySecurityUserId   String
  exitSecurityUserId    String?
  status                String    @default("INSIDE_CAMPUS") // INSIDE_CAMPUS, EXITED, OVERSTAY_ALERT, EMERGENCY_ENTRY
  isEmergency           Boolean   @default(false)
  emergencyReason       String?
  overstayAlertSent     Boolean   @default(false)
  remarks               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  visitor               Visitor            @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  personToMeet          User?              @relation("PersonToMeetVisitorEntries", fields: [personToMeetUserId], references: [id], onDelete: SetNull)
  entrySecurity         User               @relation("EntrySecurityVisitorEntries", fields: [entrySecurityUserId], references: [id], onDelete: Cascade)
  exitSecurity          User?              @relation("ExitSecurityVisitorEntries", fields: [exitSecurityUserId], references: [id], onDelete: SetNull)
  campusVehicleLogs     CampusVehicleLog[]

  @@index([visitorId])
  @@index([passNumber])
  @@index([passToken])
  @@index([status])
  @@index([entryTime])
}

model CampusVehicleLog {
  id                  String    @id @default(cuid())
  vehicleNumber       String
  driverOwnerName     String?
  vehicleType         String?
  isRegistered        Boolean   @default(false)
  vehicleId           String?
  visitorEntryId      String?
  purpose             String?
  entryTime           DateTime  @default(now())
  exitTime            DateTime?
  entrySecurityUserId String
  exitSecurityUserId  String?
  status              String    @default("INSIDE_CAMPUS") // INSIDE_CAMPUS, EXITED
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  vehicle             Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  visitorEntry        VisitorEntryExit? @relation(fields: [visitorEntryId], references: [id], onDelete: SetNull)
  entrySecurity       User              @relation("EntrySecurityCampusVehicles", fields: [entrySecurityUserId], references: [id], onDelete: Cascade)
  exitSecurity        User?             @relation("ExitSecurityCampusVehicles", fields: [exitSecurityUserId], references: [id], onDelete: SetNull)

  @@index([vehicleNumber])
  @@index([isRegistered])
  @@index([status])
  @@index([entryTime])
}

// ----------------------------------------------------
// PHASE 10: COMMUNICATION & NOTIFICATION SYSTEM ENTITIES
// ----------------------------------------------------

model Notice {
  id                    String      @id @default(cuid())
  title                 String
  content               String
  noticeType            String      @default("GENERAL") // GENERAL, ACADEMIC, HOLIDAY, EVENT, EMERGENCY, FEE, ATTENDANCE, DEPARTMENT, CLASS
  priority              String      @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  publishDate           DateTime    @default(now())
  expiryDate            DateTime?
  createdByUserId       String
  targetAudience        String      @default("ALL") // ALL, STUDENTS, FACULTY, NON_FACULTY, OFFICE_STAFF, HODS, DEPARTMENT, CLASS, SECTION, SPECIFIC_USER, PARENT_GUARDIAN
  departmentId          String?
  classId               String?
  sectionId             String?
  targetUserId          String?
  targetStudentId       String?
  attachments           String?     // JSON array string of file attachment metadata
  status                String      @default("PUBLISHED") // DRAFT, SCHEDULED, PUBLISHED, EXPIRED, ARCHIVED
  requireAcknowledgment Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  createdBy             User        @relation("CreatedNotices", fields: [createdByUserId], references: [id], onDelete: Cascade)
  department            Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  class                 Class?      @relation(fields: [classId], references: [id], onDelete: SetNull)
  section               Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  targetUser            User?       @relation("TargetUserNotices", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetStudent         Student?    @relation("TargetStudentNotices", fields: [targetStudentId], references: [id], onDelete: SetNull)

  targets               NoticeTarget[]
  acknowledgments       NoticeAcknowledgment[]

  @@index([noticeType])
  @@index([priority])
  @@index([status])
  @@index([publishDate])
  @@index([createdByUserId])
}

model NoticeTarget {
  id         String   @id @default(cuid())
  noticeId   String
  targetType String   // DEPARTMENT, CLASS, SECTION, USER, STUDENT
  targetId   String

  notice     Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([noticeId])
  @@index([targetType, targetId])
}

model NoticeAcknowledgment {
  id             String   @id @default(cuid())
  noticeId       String
  userId         String
  acknowledgedAt DateTime @default(now())
  ipAddress      String?
  deviceInfo     String?

  notice         Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([noticeId])
  @@index([userId])
}

model NotificationEventLog {
  id              String   @id @default(cuid())
  eventType       String   // STUDENT_ABSENT, ASSIGNMENT_PUBLISHED, FEE_DUE, FEE_OVERDUE, NOTICE_PUBLISHED, EMERGENCY_NOTICE, LEAVE_APPROVED, LEAVE_REJECTED, ATTENDANCE_CORRECTION_APPROVED, ATTENDANCE_CORRECTION_REJECTED, TIMETABLE_CHANGED, SUBSTITUTE_ASSIGNED, EXTRA_CLASS_APPROVED, EXTRA_CLASS_REJECTED, VISITOR_ALERT
  payload         String   // JSON string
  priority        String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  sourceModule    String   // ATTENDANCE, ASSIGNMENT, FEES, LEAVE, TIMETABLE, VISITOR, NOTICE
  status          String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  idempotencyKey  String?  @unique
  createdByUserId String?
  createdAt       DateTime @default(now())

  createdByUser   User?    @relation("CreatedEventLogs", fields: [createdByUserId], references: [id], onDelete: SetNull)
  deliveries      NotificationDelivery[]

  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

model NotificationDelivery {
  id                String    @id @default(cuid())
  eventId           String?
  userId            String?
  guardianPhone     String?
  channel           String    // IN_APP, WHATSAPP, EMAIL, SMS
  provider          String    // INTERNAL, META_WHATSAPP, SMTP, TWILIO_SMS
  providerMessageId String?
  recipientContact  String
  templateCode      String?
  variables         String?   // JSON string
  status            String    @default("QUEUED") // QUEUED, PROCESSING, SENT, DELIVERED, READ, FAILED, CANCELLED
  retryCount        Int       @default(0)
  maxRetries        Int       @default(3)
  nextRetryAt       DateTime?
  failureReason     String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  event             NotificationEventLog? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user              User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([channel])
  @@index([status])
  @@index([providerMessageId])
  @@index([nextRetryAt])
}

model MessageTemplate {
  id                   String   @id @default(cuid())
  code                 String   @unique // student_absence, assignment_notification, fee_reminder, emergency_notice, holiday_notice, event_notice, attendance_warning
  providerTemplateName String
  channel              String   @default("WHATSAPP") // WHATSAPP, EMAIL, SMS
  category             String   @default("UTILITY") // AUTHENTICATION, MARKETING, UTILITY, EMERGENCY
  language             String   @default("en_US")
  bodyPattern          String
  variables            String   // JSON array string e.g. ["parent_name", "student_name", "date"]
  providerStatus       String   @default("APPROVED") // APPROVED, PENDING, REJECTED
  isActive             Boolean  @default(true)
  createdByUserId      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  createdBy            User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([channel])
  @@index([providerStatus])
}

model NotificationPreference {
  id               String   @id @default(cuid())
  userId           String?  @unique
  guardianPhone    String?  @unique
  inAppEnabled     Boolean  @default(true)
  whatsappEnabled  Boolean  @default(true)
  emailEnabled     Boolean  @default(true)
  smsEnabled       Boolean  @default(false)
  preferredChannel String   @default("WHATSAPP") // IN_APP, WHATSAPP, EMAIL, SMS
  updatedAt        DateTime @updatedAt

  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([guardianPhone])
}

// ----------------------------------------------------
// PHASE 11: CENTRAL ADMINISTRATION & GOVERNANCE ENTITIES
// ----------------------------------------------------

model ApprovalWorkflowRule {
  id                      String   @id @default(cuid())
  targetRole              String   // HOD, FACULTY, NON_FACULTY, OFFICE_ADMIN, STUDENT
  stepOrder               Int      @default(1)
  approverRole            String   // SUPER_ADMIN, OFFICE_ADMIN, HOD
  requiresDepartmentMatch Boolean  @default(false)
  isFinalStep             Boolean  @default(true)
  createdAt               DateTime @default(now())

  @@unique([targetRole, stepOrder])
  @@index([targetRole])
  @@index([approverRole])
}

model GenericApprovalRequest {
  id                  String   @id @default(cuid())
  requestType         String   // USER_REGISTRATION, ADMISSION, FACULTY_LEAVE, ATTENDANCE_BYPASS, REFUND, VEHICLE_REGISTRATION, EXPENSE_APPROVAL
  entityType          String   // User, Student, FacultyLeave, AcademicBypassRequest, Refund, Vehicle
  entityId            String
  requestedByUserId   String
  targetDepartmentId  String?
  currentStepOrder    Int      @default(1)
  currentApproverRole String   @default("SUPER_ADMIN")
  status              String   @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED, RETURNED_FOR_CORRECTION, CANCELLED
  reason              String?
  comments            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  requestedByUser     User                @relation("RequestedByApprovalRequests", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  department          Department?         @relation(fields: [targetDepartmentId], references: [id], onDelete: SetNull)
  histories           GenericApprovalHistory[]

  @@index([requestType])
  @@index([status])
  @@index([currentApproverRole])
  @@index([requestedByUserId])
}

model GenericApprovalHistory {
  id             String   @id @default(cuid())
  requestId      String
  stepOrder      Int
  actionByUserId String
  actionRole     String
  action         String   // APPROVED, REJECTED, RETURNED_FOR_CORRECTION
  reason         String?
  actionAt       DateTime @default(now())

  request        GenericApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actionByUser   User                   @relation("ActionByApprovalHistories", fields: [actionByUserId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([actionByUserId])
}

model InstitutionSettings {
  id                             String   @id @default(cuid())
  institutionName                String   @default("St. Lawrence Educational Academy")
  logoUrl                        String?
  address                        String?  @default("100 Campus Avenue, Knowledge City")
  contactPhone                   String?  @default("+91 98765 43210")
  contactEmail                   String?  @default("principal@school.edu")
  activeAcademicYearId           String?
  attendanceThresholdPercent     Float    @default(75.0)
  attendanceSubmissionWindowMins Int      @default(120)
  visitorMaxHoursAlert           Int      @default(4)
  currencySymbol                 String   @default("₹")
  dateFormat                     String   @default("YYYY-MM-DD")
  timezone                       String   @default("Asia/Kolkata")
  updatedAt                      DateTime @updatedAt

  activeAcademicYear             AcademicYear? @relation(fields: [activeAcademicYearId], references: [id], onDelete: SetNull)
}

model AcademicYearPromotion {
  id                 String   @id @default(cuid())
  fromAcademicYearId String
  toAcademicYearId   String
  fromClassId        String
  toClassId          String
  promotedByUserId   String
  studentCount       Int
  promotedAt         DateTime @default(now())
  remarks            String?

  fromAcademicYear   AcademicYear @relation("PromotionsFrom", fields: [fromAcademicYearId], references: [id], onDelete: Cascade)
  toAcademicYear     AcademicYear @relation("PromotionsTo", fields: [toAcademicYearId], references: [id], onDelete: Cascade)
  fromClass          Class        @relation("PromotionsFromClass", fields: [fromClassId], references: [id], onDelete: Cascade)
  toClass            Class        @relation("PromotionsToClass", fields: [toClassId], references: [id], onDelete: Cascade)
  promotedByUser     User         @relation("PromotedByBatches", fields: [promotedByUserId], references: [id], onDelete: Cascade)

  @@index([fromAcademicYearId])
  @@index([toAcademicYearId])
  @@index([promotedByUserId])
}

// ----------------------------------------------------
// PHASE 12: EXAMINATION, RESULTS & ACADEMIC PERFORMANCE
// ----------------------------------------------------

model Examination {
  id             String   @id @default(cuid())
  name           String   // e.g. Mid-Term Examination 2026, Unit Test 1
  code           String   @unique // e.g. EXAM-2026-MT1
  examType       String   @default("MID_TERM") // UNIT_TEST, CLASS_TEST, INTERNAL_ASSESSMENT, MID_TERM, SEMESTER, PRELIMINARY, FINAL, PRACTICAL, VIVA, PROJECT
  academicYearId String
  term           String   @default("SEM-1") // SEM-1, SEM-2, TERM-1, TERM-2, ANNUAL
  startDate      DateTime
  endDate        DateTime
  status         String   @default("DRAFT") // DRAFT, PLANNED, SCHEDULED, ONGOING, MARKS_ENTRY, VERIFICATION, RESULT_PROCESSING, APPROVED, PUBLISHED, ARCHIVED
  description    String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear   AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  createdBy      User?                @relation("CreatedExaminations", fields: [createdById], references: [id], onDelete: SetNull)
  classes        ExaminationClass[]
  subjects       ExaminationSubject[]
  eligibilities  ExamEligibility[]
  resultSnapshots StudentResultSnapshot[]

  @@index([academicYearId])
  @@index([status])
  @@index([examType])
}

model ExaminationClass {
  id            String   @id @default(cuid())
  examinationId String
  classId       String
  sectionId     String?
  createdAt     DateTime @default(now())

  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  class         Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  section       Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([examinationId, classId, sectionId])
  @@index([examinationId])
  @@index([classId])
}

model ExaminationSubject {
  id                   String    @id @default(cuid())
  examinationId        String
  classId              String
  subjectId            String
  maxTheoryMarks       Float     @default(80.0)
  maxPracticalMarks    Float     @default(0.0)
  maxInternalMarks     Float     @default(20.0)
  totalMaxMarks        Float     @default(100.0)
  passingMarks         Float     @default(40.0)
  weightage            Float     @default(1.0)
  examDate             String?   // YYYY-MM-DD
  startTime            String?   // e.g. 09:30
  endTime              String?   // e.g. 12:30
  roomId               String?
  invigilatorFacultyId String?
  instructions         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  examination          Examination        @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  class                Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject              Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  room                 Room?              @relation("RoomExamSubjects", fields: [roomId], references: [id], onDelete: SetNull)
  invigilatorFaculty   Faculty?           @relation("InvigilatorFacultySubjects", fields: [invigilatorFacultyId], references: [id], onDelete: SetNull)
  attendances          ExamAttendance[]
  studentMarks         StudentMarks[]

  @@unique([examinationId, classId, subjectId])
  @@index([examinationId])
  @@index([classId])
  @@index([subjectId])
}

model ExamEligibility {
  id                   String   @id @default(cuid())
  examinationId        String
  studentId            String
  attendancePercentage Float    @default(100.0)
  feeClearanceStatus   String   @default("CLEARED") // CLEARED, PENDING_DUES, BLOCKED
  status               String   @default("ELIGIBLE") // ELIGIBLE, CONDITIONALLY_ELIGIBLE, NOT_ELIGIBLE, EXEMPTED, SPECIAL_PERMISSION
  remarks              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  examination          Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  student              Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examinationId, studentId])
  @@index([examinationId])
  @@index([studentId])
  @@index([status])
}

model ExamAttendance {
  id                   String   @id @default(cuid())
  examinationSubjectId String
  studentId            String
  status               String   @default("PRESENT") // PRESENT, ABSENT, LATE, EXEMPTED, MALPRACTICE_HOLD
  seatNumber           String?
  markedByUserId       String?
  markedAt             DateTime @default(now())

  examinationSubject   ExaminationSubject @relation(fields: [examinationSubjectId], references: [id], onDelete: Cascade)
  student              Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy             User?              @relation("MarkedByExamAttendances", fields: [markedByUserId], references: [id], onDelete: SetNull)

  @@unique([examinationSubjectId, studentId])
  @@index([examinationSubjectId])
  @@index([studentId])
  @@index([status])
}

model StudentMarks {
  id                   String   @id @default(cuid())
  examinationSubjectId String
  studentId            String
  subjectId            String
  obtainedTheoryMarks  Float    @default(0.0)
  obtainedPracticalMarks Float  @default(0.0)
  obtainedInternalMarks Float   @default(0.0)
  totalObtainedMarks   Float    @default(0.0)
  isAbsent             Boolean  @default(false)
  remarks              String?
  status               String   @default("DRAFT") // DRAFT, SUBMITTED, VERIFIED, RETURNED_FOR_CORRECTION
  enteredByUserId      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  examinationSubject   ExaminationSubject       @relation(fields: [examinationSubjectId], references: [id], onDelete: Cascade)
  student              Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject              Subject                  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  enteredBy            User?                    @relation("EnteredByMarks", fields: [enteredByUserId], references: [id], onDelete: SetNull)
  correctionRequests   MarksCorrectionRequest[]

  @@unique([examinationSubjectId, studentId])
  @@index([examinationSubjectId])
  @@index([studentId])
  @@index([status])
}

model MarksCorrectionRequest {
  id                String   @id @default(cuid())
  studentMarksId    String
  requestedByUserId String
  existingMarks     Float
  requestedMarks    Float
  reason            String
  status            String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedByUserId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  studentMarks      StudentMarks @relation(fields: [studentMarksId], references: [id], onDelete: Cascade)
  requestedBy       User         @relation("RequestedByMarksCorrections", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reviewedBy        User?        @relation("ReviewedByMarksCorrections", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([studentMarksId])
  @@index([status])
}

model GradeScaleRule {
  id             String   @id @default(cuid())
  gradeName      String   // A+, A, B+, B, C, D, F
  minPercentage  Float
  maxPercentage  Float
  gradePoint     Float    @default(0.0)
  passFailStatus String   @default("PASS") // PASS, FAIL
  displayLabel   String?
  createdAt      DateTime @default(now())

  @@unique([gradeName])
  @@index([minPercentage])
}

model StudentResultSnapshot {
  id                String   @id @default(cuid())
  resultNumber      String   @unique // e.g. RES-2026-0001
  version           Int      @default(1)
  examinationId     String
  studentId         String
  totalObtainedMarks Float
  totalMaxMarks     Float
  overallPercentage Float
  grade             String
  gradePoint        Float    @default(0.0)
  overallResult     String   @default("PASS") // PASS, FAIL, HELD
  classRank         Int?
  verificationToken String   @unique
  publishedDate     DateTime @default(now())
  approvedByUserId  String?
  status            String   @default("PUBLISHED") // DRAFT, CALCULATED, VERIFIED, APPROVED, PUBLISHED, REVISED, ARCHIVED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  examination       Examination                 @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  student           Student                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  approvedBy        User?                       @relation("ApprovedResultSnapshots", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  subjectDetails    StudentResultSubjectDetail[]

  @@unique([examinationId, studentId, version])
  @@index([examinationId])
  @@index([studentId])
  @@index([verificationToken])
  @@index([status])
}

model StudentResultSubjectDetail {
  id                 String   @id @default(cuid())
  resultSnapshotId   String
  subjectId          String
  subjectName        String
  obtainedMarks      Float
  maxMarks           Float
  grade              String
  passFailStatus     String   @default("PASS") // PASS, FAIL

  resultSnapshot     StudentResultSnapshot @relation(fields: [resultSnapshotId], references: [id], onDelete: Cascade)
  subject            Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([resultSnapshotId])
  @@index([subjectId])
}

// ----------------------------------------------------
// PHASE 13: STUDENT AND PARENT/GUARDIAN PORTALS
// ----------------------------------------------------

model GuardianStudentRelationship {
  id             String   @id @default(cuid())
  guardianUserId String
  studentId      String
  relationship   String   @default("PARENT") // FATHER, MOTHER, LEGAL_GUARDIAN, PARENT
  isPrimary      Boolean  @default(true)
  status         String   @default("ACTIVE") // ACTIVE, REVOKED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  guardianUser   User     @relation("GuardianUserRelationships", fields: [guardianUserId], references: [id], onDelete: Cascade)
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianUserId, studentId])
  @@index([guardianUserId])
  @@index([studentId])
  @@index([status])
}

model StudentProfileUpdateRequest {
  id                String    @id @default(cuid())
  studentId         String
  requestedByUserId String
  fieldChanges      String    // JSON string of proposed field changes e.g. { address: "...", phone: "..." }
  reason            String?
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedByUserId  String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestedBy       User      @relation("RequestedStudentProfileUpdates", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reviewedBy        User?     @relation("ReviewedStudentProfileUpdates", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([status])
}

model StudentLeaveRequest {
  id                String    @id @default(cuid())
  studentId         String
  requestedByUserId String
  startDate         DateTime
  endDate           DateTime
  totalDays         Int       @default(1)
  reason            String
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedByUserId  String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestedBy       User      @relation("RequestedStudentLeaves", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reviewedBy        User?     @relation("ReviewedStudentLeaves", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([status])
}

model GuardianCommunicationPreference {
  id             String   @id @default(cuid())
  guardianUserId String   @unique
  whatsAppEnabled Boolean @default(true)
  emailEnabled    Boolean @default(true)
  inAppEnabled    Boolean @default(true)
  smsEnabled      Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  guardianUser   User     @relation(fields: [guardianUserId], references: [id], onDelete: Cascade)

  @@index([guardianUserId])
}

// ===== PHASE 15: SUPPORT TICKET SYSTEM =====

model SupportTicket {
  id               String    @id @default(cuid())
  ticketNumber     String    @unique // e.g. TKT-2026-0001
  userId           String    // Creator
  category         String    // LOGIN, ATTENDANCE, FEE, ASSIGNMENT, RESULT, PROFILE, GENERAL, OTHER
  description      String
  priority         String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status           String    @default("OPEN")   // OPEN, IN_PROGRESS, WAITING, RESOLVED, CLOSED
  assignedToUserId String?
  resolution       String?
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User                   @relation("CreatedTickets", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo       User?                  @relation("AssignedTickets", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  comments         SupportTicketComment[]

  @@index([userId])
  @@index([status])
  @@index([assignedToUserId])
  @@index([category])
}

model SupportTicketComment {
  id         String   @id @default(cuid())
  ticketId   String
  userId     String
  comment    String
  isInternal Boolean  @default(false) // Internal notes only visible to staff
  createdAt  DateTime @default(now())

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User          @relation("TicketComments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([userId])
}

// ===== PHASE 15: DATA IMPORT SYSTEM =====

model DataImportLog {
  id              String          @id @default(cuid())
  importType      String          // STUDENTS, FACULTY, FEE_STRUCTURES
  filename        String
  uploadedByUserId String
  totalRows       Int             @default(0)
  successRows     Int             @default(0)
  failedRows      Int             @default(0)
  skippedRows     Int             @default(0)
  status          String          @default("PREVIEW") // PREVIEW, CONFIRMED, PARTIALLY_IMPORTED, FAILED, ROLLED_BACK
  errorSummary    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  uploadedBy      User            @relation("ImportLogs", fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  rows            DataImportRow[]

  @@index([uploadedByUserId])
  @@index([importType])
  @@index([status])
}

model DataImportRow {
  id           String   @id @default(cuid())
  importLogId  String
  rowIndex     Int
  rowData      String   // JSON string of raw row data
  status       String   @default("PENDING") // PENDING, SUCCESS, FAILED, SKIPPED
  errorMessage String?
  createdAt    DateTime @default(now())

  importLog    DataImportLog @relation(fields: [importLogId], references: [id], onDelete: Cascade)

  @@index([importLogId])
  @@index([status])
}

// ==========================================
// PHASE 16: ADVANCED SMART SCHOOL OPERATIONS,
// REAL-TIME, EMERGENCY, CASE MANAGEMENT & PWA
// ==========================================

model EmergencyAlert {
  id              String    @id @default(cuid())
  title           String
  message         String
  priority        String    @default("HIGH") // NORMAL, HIGH, EMERGENCY
  targetAudience  String    @default("ALL") // ALL, FACULTY, STUDENTS, PARENTS, STAFF
  channels        String    @default("IN_APP") // Comma-separated: IN_APP,EMAIL,SMS,WHATSAPP,PUSH
  status          String    @default("SENT") // DRAFT, SENT, CANCELLED
  createdById     String
  approvedById    String?
  sentAt          DateTime  @default(now())
  cancelledAt     DateTime?
  cancellationNote String?
  deliveryStats   String?   // JSON delivery counts: { inApp: 150, email: 120, whatsApp: 0 }
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdBy       User      @relation("CreatedEmergencyAlerts", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy      User?     @relation("ApprovedEmergencyAlerts", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([priority])
  @@index([createdById])
  @@index([sentAt])
}

model CampusStatusLog {
  id          String   @id @default(cuid())
  status      String   @default("NORMAL") // NORMAL, WARNING, EMERGENCY
  reason      String?
  updatedById String
  createdAt   DateTime @default(now())

  updatedBy   User     @relation("CampusStatusUpdater", fields: [updatedById], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

model StudentCase {
  id               String              @id @default(cuid())
  studentId        String
  caseNumber       String              @unique // e.g. CASE-20260825-001
  caseType         String              @default("ACADEMIC") // ATTENDANCE, ACADEMIC, FEE, PROFILE_CORRECTION, DOCUMENT, PARENT_COMMUNICATION, ADMINISTRATIVE_REQUEST
  priority         String              @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  title            String
  description      String
  status           String              @default("CREATED") // CREATED, ASSIGNED, UNDER_REVIEW, ACTION_REQUIRED, RESOLVED, CLOSED
  assignedToUserId String?
  resolution       String?
  createdById      String
  closedAt         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  student          Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy        User                @relation("CreatedStudentCases", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo       User?               @relation("AssignedStudentCases", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  actions          StudentCaseAction[]

  @@index([studentId])
  @@index([caseType])
  @@index([status])
  @@index([priority])
  @@index([assignedToUserId])
  @@index([createdById])
}

model StudentCaseAction {
  id                String      @id @default(cuid())
  caseId            String
  actionType        String      // STATUS_CHANGE, ASSIGNED, NOTE_ADDED, RESOLVED, CLOSED
  note              String
  performedByUserId String
  createdAt         DateTime    @default(now())

  case              StudentCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  performedBy       User        @relation("StudentCaseActionPerformer", fields: [performedByUserId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([performedByUserId])
  @@index([createdAt])
}

model VisitorPreRegistration {
  id                 String    @id @default(cuid())
  visitorFullName    String
  contactNumber      String
  expectedDate       String    // YYYY-MM-DD
  hostUserId         String
  purpose            String
  securityPassNumber String?   @unique
  status             String    @default("PENDING_ARRIVAL") // PENDING_ARRIVAL, ARRIVED, CANCELLED, EXPIRED
  checkedInTime      DateTime?
  remarks            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  hostUser           User      @relation("HostVisitorPreRegistrations", fields: [hostUserId], references: [id], onDelete: Cascade)

  @@index([hostUserId])
  @@index([expectedDate])
  @@index([status])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. ONLINE_PAYMENTS, AI_INSIGHTS, PWA_OFFLINE
  name        String
  description String?
  isEnabled   Boolean  @default(true)
  category    String   @default("GENERAL") // GENERAL, AI, COMMUNICATION, PAYMENTS, SECURITY
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([category])
}

model ConfigAuditLog {
  id          String   @id @default(cuid())
  configKey   String
  oldValue    String?
  newValue    String
  reason      String?
  updatedById String
  createdAt   DateTime @default(now())

  updatedBy   User     @relation("ConfigAuditUpdater", fields: [updatedById], references: [id], onDelete: Cascade)

  @@index([configKey])
  @@index([updatedById])
  @@index([createdAt])
}

model WebhookLog {
  id             String   @id @default(cuid())
  provider       String   // WHATSAPP, PAYMENT_GATEWAY, EMAIL_SMTP, CUSTOM
  eventId        String?
  eventType      String
  payload        String   // JSON string
  status         String   @default("RECEIVED") // RECEIVED, PROCESSED, FAILED, DUPLICATE
  idempotencyKey String?  @unique
  errorMessage   String?
  createdAt      DateTime @default(now())
  processedAt    DateTime?

  @@index([provider])
  @@index([status])
  @@index([eventType])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  auth      String
  p256dh    String
  userAgent String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

// ====================================================
// PHASE 17 — INSTITUTIONAL INTELLIGENCE & OPERATIONS
// ====================================================

model ApprovalDelegation {
  id                    String   @id @default(cuid())
  originalApproverUserId String
  delegateUserId        String
  startDate             DateTime
  endDate               DateTime
  reason                String
  scope                 String   @default("ALL") // ALL, LEAVE, MARKS, ATTENDANCE, FEES
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  originalApprover      User     @relation("OriginalApproverDelegations", fields: [originalApproverUserId], references: [id], onDelete: Cascade)
  delegateUser          User     @relation("DelegateUserDelegations", fields: [delegateUserId], references: [id], onDelete: Cascade)

  @@index([originalApproverUserId])
  @@index([delegateUserId])
  @@index([isActive])
}

model WorkflowSlaConfig {
  id             String   @id @default(cuid())
  workflowType   String   @unique // USER_APPROVAL, LEAVE_APPROVAL, MARKS_CORRECTION, ATTENDANCE_CORRECTION, FEE_ADJUSTMENT, DOCUMENT_VERIFICATION
  targetHours    Int      @default(48) // e.g. 48 hours
  reminderHours  Int      @default(24) // e.g. 24 hours
  escalateToRole String?  // SUPER_ADMIN, OFFICE_ADMIN, HOD
  escalateToUserId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workflowType])
}

model InstitutionalCalendarEvent {
  id             String   @id @default(cuid())
  title          String
  description    String?
  category       String   // ACADEMIC, HOLIDAY, EXAM, EVENT, PTM, VACATION, SPORTS, CULTURAL, MEETING
  startDate      DateTime
  endDate        DateTime
  isHoliday      Boolean  @default(false)
  allDay         Boolean  @default(true)
  targetRoles    String   @default("ALL") // JSON array or comma-separated: ALL, SUPER_ADMIN, FACULTY, STUDENT, PARENT
  departmentId   String?
  classId        String?
  venue          String?
  organizerUserId String?
  capacity       Int?
  registeredCount Int     @default(0)
  status         String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  registrations  EventRegistration[]

  @@index([category])
  @@index([startDate])
  @@index([endDate])
  @@index([isHoliday])
}

model EventRegistration {
  id             String   @id @default(cuid())
  eventId        String
  userId         String?
  studentId      String?
  status         String   @default("REGISTERED") // REGISTERED, WAITLIST, CANCELLED
  attended       Boolean  @default(false)
  attendedAt     DateTime?
  createdAt      DateTime @default(now())

  event          InstitutionalCalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User?    @relation("UserEventRegistrations", fields: [userId], references: [id], onDelete: SetNull)
  student        Student? @relation("StudentEventRegistrations", fields: [studentId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([userId])
  @@index([studentId])
}

model ParentTeacherMeetingSlot {
  id              String   @id @default(cuid())
  facultyId       String
  date            String   // YYYY-MM-DD
  startTime       String   // HH:MM
  endTime         String   // HH:MM
  durationMinutes Int      @default(15)
  maxBookings     Int      @default(1)
  currentBookings Int      @default(0)
  status          String   @default("AVAILABLE") // AVAILABLE, BOOKED, CANCELLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  faculty         Faculty  @relation("FacultyPtmSlots", fields: [facultyId], references: [id], onDelete: Cascade)
  bookings        ParentTeacherMeetingBooking[]

  @@index([facultyId])
  @@index([date])
  @@index([status])
}

model ParentTeacherMeetingBooking {
  id               String   @id @default(cuid())
  slotId           String
  studentId        String
  guardianUserId   String
  status           String   @default("CONFIRMED") // CONFIRMED, COMPLETED, CANCELLED, NO_SHOW
  meetingNotes     String?
  sensitiveRemarks String?
  bookedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  slot             ParentTeacherMeetingSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  student          Student  @relation("StudentPtmBookings", fields: [studentId], references: [id], onDelete: Cascade)
  guardianUser     User     @relation("GuardianPtmBookings", fields: [guardianUserId], references: [id], onDelete: Cascade)

  @@unique([slotId, studentId])
  @@index([slotId])
  @@index([studentId])
  @@index([guardianUserId])
}

model StudentExitChecklist {
  id                String   @id @default(cuid())
  studentId         String   @unique
  feeClearance      Boolean  @default(false)
  libraryClearance  Boolean  @default(false)
  assetClearance    Boolean  @default(false)
  documentClearance Boolean  @default(false)
  idCardReturned    Boolean  @default(false)
  status            String   @default("PENDING") // PENDING, APPROVED, REJECTED
  remarks           String?
  approvedByUserId  String?
  exitDate          DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  approvedByUser    User?    @relation("ApprovedStudentExits", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([status])
}

model AlumniProfile {
  id             String   @id @default(cuid())
  studentId      String   @unique
  graduationYear Int
  programName    String
  currentCompany String?
  currentRole    String?
  contactEmail   String?
  contactPhone   String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([graduationYear])
}

model StaffOnboardingChecklist {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  documentsVerified      Boolean  @default(false)
  roleAssigned           Boolean  @default(false)
  departmentAssigned     Boolean  @default(false)
  reportingManagerAssigned Boolean @default(false)
  emergencyContactRecorded Boolean @default(false)
  status                 String   @default("PENDING") // PENDING, COMPLETED
  verifiedByUserId       String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                   User     @relation("StaffOnboardingUser", fields: [userId], references: [id], onDelete: Cascade)
  verifiedByUser         User?    @relation("VerifiedStaffOnboardings", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model StaffExitHandover {
  id                    String   @id @default(cuid())
  userId                String   @unique
  handoverToUserId      String?
  exitDate              DateTime
  classesReassigned     Boolean  @default(false)
  pendingMarksReassigned Boolean @default(false)
  approvalsReassigned   Boolean  @default(false)
  assetsReturned        Boolean  @default(false)
  status                String   @default("PENDING") // PENDING, COMPLETED
  verifiedByUserId      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User     @relation("StaffExitUser", fields: [userId], references: [id], onDelete: Cascade)
  handoverToUser        User?    @relation("HandoverToUser", fields: [handoverToUserId], references: [id], onDelete: SetNull)
  verifiedByUser        User?    @relation("VerifiedStaffHandovers", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model InstitutionalAsset {
  id            String   @id @default(cuid())
  assetCode     String   @unique // e.g. AST-LAP-001
  name          String
  category      String   // IT_EQUIPMENT, LAB_EQUIPMENT, FURNITURE, AV_EQUIPMENT, FACILITY, VEHICLE_ACCESSORY
  serialNumber  String?
  location      String   // e.g. Room 204, Lab 2
  assignedToUserId String?
  status        String   @default("AVAILABLE") // AVAILABLE, ASSIGNED, UNDER_MAINTENANCE, RETIRED
  purchaseDate  DateTime?
  warrantyExpiry DateTime?
  purchaseCost  Float?   @default(0.0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignedToUser User?   @relation("AssignedUserAssets", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignments    AssetAssignmentHistory[]
  maintenances   AssetMaintenanceLog[]

  @@index([assetCode])
  @@index([category])
  @@index([status])
}

model AssetAssignmentHistory {
  id             String   @id @default(cuid())
  assetId        String
  assignedToUserId String
  assignedByUserId String
  assignedAt     DateTime @default(now())
  returnedAt     DateTime?
  conditionNotes String?
  createdAt      DateTime @default(now())

  asset          InstitutionalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignedByUser User     @relation("AssignedByAssetAssignments", fields: [assignedByUserId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([assignedToUserId])
}

model AssetMaintenanceLog {
  id                 String   @id @default(cuid())
  assetId            String
  maintenanceDate    DateTime
  vendorName         String
  cost               Float    @default(0.0)
  issueDescription   String
  resolutionDetails  String?
  nextMaintenanceDate DateTime?
  status             String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED
  createdAt          DateTime @default(now())

  asset              InstitutionalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([status])
}

model InventoryItem {
  id                  String   @id @default(cuid())
  itemCode            String   @unique // e.g. INV-STA-001
  name                String
  category            String   // STATIONERY, LAB_SUPPLIES, SPORTS, CONSUMABLES, CLEANING, IT_SUPPLIES
  unit                String   // Box, Pcs, Ream, Pack
  currentQuantity     Int      @default(0)
  minThresholdQuantity Int     @default(10)
  unitCost            Float    @default(0.0)
  location            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  transactions        InventoryTransaction[]

  @@index([itemCode])
  @@index([category])
}

model InventoryTransaction {
  id              String   @id @default(cuid())
  inventoryItemId String
  transactionType String   // STOCK_IN, STOCK_OUT, ADJUSTMENT
  quantity        Int
  unitCost        Float?
  reason          String
  requestedByUserId String?
  approvedByUserId String?
  createdAt       DateTime @default(now())

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([transactionType])
  @@index([createdAt])
}

model InstitutionalGrievance {
  id               String   @id @default(cuid())
  trackingNumber   String   @unique // e.g. GRV-2026-0001
  category         String   // ACADEMIC, ADMINISTRATIVE, FINANCE, ATTENDANCE, FACILITY, TRANSPORT, TECHNOLOGY, OTHER
  privacyLevel     String   @default("NORMAL") // NORMAL, RESTRICTED, CONFIDENTIAL
  title            String
  description      String
  submittedByUserId String
  isAnonymous      Boolean  @default(false)
  assignedToUserId String?
  status           String   @default("SUBMITTED") // SUBMITTED, ASSIGNED, INVESTIGATING, ACTION_REQUIRED, RESOLVED, CLOSED
  resolutionNotes  String?
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  submittedByUser  User     @relation("SubmittedGrievances", fields: [submittedByUserId], references: [id], onDelete: Cascade)
  assignedToUser   User?    @relation("AssignedGrievances", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([trackingNumber])
  @@index([category])
  @@index([privacyLevel])
  @@index([status])
}

model InstitutionalFeedback {
  id                String   @id @default(cuid())
  targetType        String   // COURSE, FACULTY, EVENT, FACILITY, SERVICE
  targetId          String?  // ID of course/event/faculty
  submittedByUserId String
  rating            Int      @default(5) // 1 to 5
  comments          String?
  academicYearId    String?
  createdAt         DateTime @default(now())

  submittedByUser   User     @relation("SubmittedFeedbacks", fields: [submittedByUserId], references: [id], onDelete: Cascade)

  @@index([targetType])
  @@index([targetId])
  @@index([submittedByUserId])
}

model InstitutionalPolicy {
  id             String   @id @default(cuid())
  policyCode     String   // e.g. POL-ATT-01
  title          String
  category       String   // ATTENDANCE, FEES, EXAMINATION, LEAVE, VEHICLE, VISITOR, CONDUCT, DATA_PRIVACY, GENERAL
  version        Int      @default(1)
  effectiveDate  DateTime
  reviewDate     DateTime?
  documentUrl    String?
  content        String
  status         String   @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  createdByUserId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdByUser  User     @relation("CreatedPolicies", fields: [createdByUserId], references: [id], onDelete: Cascade)
  acknowledgements PolicyAcknowledgement[]

  @@unique([policyCode, version])
  @@index([policyCode])
  @@index([category])
  @@index([status])
}

model PolicyAcknowledgement {
  id            String   @id @default(cuid())
  policyId      String
  policyVersion Int
  userId        String
  acknowledgedAt DateTime @default(now())

  policy        InstitutionalPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user          User     @relation("UserPolicyAcknowledgements", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([policyId, policyVersion, userId])
  @@index([policyId])
  @@index([userId])
}

model ComplianceChecklistItem {
  id              String   @id @default(cuid())
  category        String   // ADMISSION, ONBOARDING, EXAMINATION, RESULT_PUBLISH, FLEET, SECURITY, BACKUP, GENERAL
  title           String
  description     String?
  frequency       String   @default("MONTHLY") // DAILY, WEEKLY, MONTHLY, TERMLY, ANNUAL
  dueDate         DateTime
  status          String   @default("PENDING") // PENDING, COMPLETED, OVERDUE
  verifiedByUserId String?
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  verifiedByUser  User?    @relation("VerifiedComplianceItems", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([status])
  @@index([dueDate])
}

model OperationalRecommendation {
  id                String   @id @default(cuid())
  observation       String
  evidenceJson      String   // JSON string of metrics & dataSource
  suggestedAction   String
  priority          String   @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW
  status            String   @default("NEW") // NEW, ACKNOWLEDGED, IN_PROGRESS, RESOLVED, DISMISSED
  reasonForDismissal String?
  assignedToUserId  String?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assignedToUser    User?    @relation("AssignedRecommendations", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  reviewedByUser    User?    @relation("ReviewedRecommendations", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([priority])
  @@index([status])
}

model InstitutionalIncident {
  id                 String   @id @default(cuid())
  incidentCode       String   @unique // e.g. INC-2026-001
  severity           String   @default("P3_MEDIUM") // P1_CRITICAL, P2_HIGH, P3_MEDIUM, P4_LOW
  category           String   // SYSTEM_OUTAGE, SECURITY_EVENT, CAMPUS_EVENT, DATA_ISSUE, NOTIFICATION_OUTAGE, PAYMENT_OUTAGE, OTHER
  title              String
  description        String
  detectedAt         DateTime @default(now())
  acknowledgedAt     DateTime?
  mitigatedAt        DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  rootCauseAnalysis  String?
  correctiveActions  String?
  preventiveActions  String?
  ownerUserId        String?
  status             String   @default("DETECTED") // DETECTED, ACKNOWLEDGED, INVESTIGATING, MITIGATED, RESOLVED, CLOSED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ownerUser          User?    @relation("OwnedIncidents", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([incidentCode])
  @@index([severity])
  @@index([status])
}

model DataCorrectionRequest {
  id                String   @id @default(cuid())
  entityType        String   // STUDENT_DOB, STUDENT_NAME, GUARDIAN_INFO, FEE_ADJUSTMENT, ATTENDANCE_RECORD, MARKS_RECORD
  entityId          String
  fieldName         String
  oldValue          String?
  newValue          String
  reason            String
  requestedByUserId String
  approvedByUserId  String?
  status            String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason   String?
  executedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  requestedByUser   User     @relation("RequestedDataCorrections", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  approvedByUser    User?    @relation("ApprovedDataCorrections", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([entityType])
  @@index([entityId])
  @@index([status])
}







